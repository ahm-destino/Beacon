# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-here-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beacon_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI
GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL is locked in code (app/services/ai_service.py)
# GROQ_MODEL=llama-3.1-8b-instant

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=beacon-uploads
AWS_REGION=eu-west-1

# SMS (Termii - Nigerian Provider)
TERMII_API_KEY=xxxxx
TERMII_SENDER_ID=Beacon

# Push Notifications
FCM_SERVER_KEY=xxxxx

# Email (SendGrid)
SENDGRID_API_KEY=xxxxx
FROM_EMAIL=hello@beacon.ng

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
