# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-here-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beacon_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI
GROQ_API_KEY=your-groq-key-here
AI_CORRECT_ON_ANSWER=0
AI_ANSWER_PROVIDER=groq
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GEMINI_MODELS=gemini-pro-latest,gemini-flash-latest,gemini-flash-lite-latest,gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite-preview-09-2025,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-pro
GEMINI_USE_SEARCH=0

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=beacon-uploads
AWS_REGION=eu-west-1

# SMS (Termii - Nigerian Provider)
TERMII_API_KEY=xxxxx
TERMII_SENDER_ID=Beacon

# Push Notifications
FCM_SERVER_KEY=xxxxx

# Email (SendGrid)
SENDGRID_API_KEY=xxxxx
FROM_EMAIL=hello@beacon.ng

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
